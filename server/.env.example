# Copy to .env and fill in before running locally or deploying.

# --- Database: Neon Postgres (required) ---
# Vercel → Storage → your Neon store → .env.local → copy the pooled connection string.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- File storage: Vercel Blob, PUBLIC store (required for uploads + AI-on-PDF) ---
# Vercel → Storage → your public Blob store → .env.local → copy the token.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# --- Auth ---
# Any long random string. Rotating it signs every admin out.
JWT_SECRET=replace-with-a-long-random-string
# Plain admin password for /admin…
ADMIN_PASSWORD=miv-admin
# …or a bcrypt hash for production (takes priority over ADMIN_PASSWORD).
# Generate: node -e "console.log(require('bcryptjs').hashSync('your-password',10))"
# ADMIN_PASSWORD_HASH=

# --- AI assistant (optional) ---
# Google Gemini key(s) (aistudio.google.com/apikey). Comma-separated — the server
# rotates to the next key when one hits its quota (429).
# GEMINI_API_KEYS=

# --- Misc ---
# Restrict who may call the API once deployed (leave * for same-origin front+API).
CORS_ORIGIN=*
# Local dev port (Vercel sets its own).
PORT=4000
