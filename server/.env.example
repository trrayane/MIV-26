# Copy to .env and adjust before deploying
PORT=4000
# Any long random string. Rotating it signs every admin out.
JWT_SECRET=replace-with-a-long-random-string
# Plain password for local use...
ADMIN_PASSWORD=miv-admin
# ...or a bcrypt hash for production (takes priority over ADMIN_PASSWORD).
# Generate: node -e "console.log(require('bcryptjs').hashSync('your-password',10))"
# ADMIN_PASSWORD_HASH=
# Restrict who may call the API once deployed
CORS_ORIGIN=*
# Where miv.db lives (use a mounted volume on Railway/Render)
# DATA_DIR=/data
# Google Gemini API key(s) (aistudio.google.com/apikey), powers the per-module AI assistant.
# Comma-separated — the server rotates to the next key when one runs out of quota (429).
# GEMINI_API_KEYS=
